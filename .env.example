# Required for web_crawl/deep_search. Keep this file mode 600.

# Defaults match the services on phrogvps.
SEARXNG_URL=http://127.0.0.1:8888
CRAWL4AI_URL=http://127.0.0.1:11235
WEB_MCP_REQUEST_TIMEOUT_S=45
WEB_MCP_MAX_URLS=10
WEB_MCP_MAX_MARKDOWN_CHARS=50000
# Set only for a deliberately trusted internal deployment.
ALLOW_PRIVATE_URLS=0
CRAWL4AI_API_TOKEN=your_token_here

# Homelab-IP crawler (crawl4ai-home), retried for failed/blocked URLs.
CRAWL4AI_FALLBACK_URL=http://127.0.0.1:11236
# tencentvps egress for plain fetches (privoxy on localhost); direct homelab is the fallback.
WEB_MCP_PLAIN_PROXY=127.0.0.1:18118
# Reddit blocks tencentvps; keep the Reddit MCP on the homelab crawler.
REDDIT_CRAWL4AI_URL=http://127.0.0.1:11236
OMNIROUTE_API_KEY=your_key_here
# Jev browse mode: decision endpoint. Fill TYPESAFE_API_KEY to enable. Default endpoint is TypeSafe (https://api.typesafe.ai).
# For Codiv's free hosted OpenJev: TYPESAFE_BASE_URL=https://api.codiv.ai and TYPESAFE_MODEL=openjev-latest. Self-hosted OpenJev: http://127.0.0.1:8080
TYPESAFE_API_KEY=your_key_here
BU_CDP_URL=http://127.0.0.1:9222
# OpenRouter key (owner-supplied 2026-10-12): Jev decision endpoint + text helper candidates
OPENROUTER_API_KEY=your_key_here

# SQLite file for the personalization DB (default: data/personal.db in the project).
# PHROG_PERSONAL_DB=/path/to/personal.db
# Instagram collector command; it is called with --account <name> [--limit N] [--cursor C].
PHROG_IG_COLLECTOR_CMD=ssh user@collector-host python3 ~/.local/share/phrog-web/ig_timeline.py
# Collector timeout in seconds (default 240).
PHROG_IG_COLLECTOR_TIMEOUT_S=240

# Local wiki storage (relative paths resolve from the process working directory)
# WIKI_DIR=./wiki
# WIKI_INBOX_DIR=./wiki/inbox
# WIKI_INDEX_PATH=./wiki/.index.db

# Persistent embedded research vault, runs, outputs and agent state.
# PHROG_FEYNMAN_DATA_DIR=/path/to/phrog-web/feynman
