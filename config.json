{
  "server": {
    "host": "127.0.0.1",
    "port": 8890
  },
  "search": {
    "pipeline": [
      "tinyfish",
      "exa",
      "searxng"
    ],
    "providers": {
      "searxng": {
        "url": "http://127.0.0.1:8888",
        "timeoutMs": 9000,
        "defaultCategories": [
          "general"
        ]
      },
      "tinyfish": {
        "url": "https://api.search.tinyfish.ai",
        "timeoutMs": 5000
      },
      "exa": {
        "url": "https://mcp.exa.ai/mcp",
        "timeoutMs": 6000
      },
      "anysearch": {
        "url": "https://api.anysearch.com/v1/search",
        "timeoutMs": 7000
      },
      "firecrawl": {
        "url": "https://api.firecrawl.dev/v1/search",
        "timeoutMs": 20000
      },
      "wikimedia": {
        "url": "https://en.wikipedia.org/w/api.php",
        "timeoutMs": 6000
      }
    },
    "fallbackEngines": [
      "searxng"
    ]
  },
  "fetch": {
    "pipeline": [
      "plain",
      "crawl4ai",
      "jina",
      "tinyfish"
    ],
    "providers": {
      "plain": {
        "timeoutMs": 4000,
        "maxChars": 60000
      },
      "crawl4ai": {
        "primaryUrl": "http://127.0.0.1:11235",
        "fallbackUrl": "http://127.0.0.1:11236",
        "timeoutMs": 20000
      },
      "tinyfish": {
        "url": "https://api.fetch.tinyfish.ai",
        "timeoutMs": 15000
      },
      "jina": {
        "url": "https://r.jina.ai",
        "timeoutMs": 30000
      }
    }
  },
  "research": {
    "feynman": {
      "binPath": "engines/feynman/bin/feynman.js",
      "outputsDir": "outputs"
    },
    "quick": {
      "timeoutMs": 60000,
      "limit": 10
    }
  }
}