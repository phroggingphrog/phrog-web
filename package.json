{
  "name": "phrog-web",
  "version": "0.1.0",
  "description": "Unified, agent-agnostic web intelligence, search, and research hub",
  "main": "dist/index.js",
  "bin": {
    "phrog-web": "dist/cli.js"
  },
  "type": "module",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "setup": "tsc && node dist/setup.js",
    "test:personal": "node --import tsx --test tests/personalization/*.test.ts",
    "bench": "npm run bench:eval",
    "bench:corpus": "node --import tsx bench/from-history.ts",
    "bench:capture": "node --import tsx bench/capture.ts",
    "bench:capture:history": "node --import tsx bench/capture.ts --corpus=bench/queries.history.json",
    "bench:eval": "node --import tsx bench/eval.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.0",
    "fastify": "^4.28.1",
    "@fastify/cors": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
