{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phrog-web/schemas/feed.v1.json",
  "title": "feed.v1",
  "type": "object",
  "required": [
    "schema_version",
    "provider",
    "account",
    "source",
    "status",
    "fetched_at",
    "cursor",
    "next_cursor",
    "items",
    "filtered_out"
  ],
  "properties": {
    "schema_version": {
      "const": "feed.v1"
    },
    "provider": {
      "enum": [
        "instagram",
        "rss"
      ]
    },
    "account": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "description": "\"home\" for instagram; for rss an RSSHub route (\"/youtube/channel/UC...\") or an http(s) feed URL"
    },
    "status": {
      "enum": [
        "ok",
        "end",
        "auth_required",
        "challenge",
        "rate_limited",
        "busy",
        "unsupported",
        "failed"
      ]
    },
    "fetched_at": {
      "type": "string"
    },
    "cursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "error": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "position",
          "item_id",
          "native_id",
          "url",
          "type",
          "sponsored",
          "suggested",
          "author",
          "caption",
          "hashtags",
          "mentions",
          "media",
          "posted_at",
          "posted_precision",
          "location",
          "like_count",
          "comment_count",
          "seen_before",
          "first_seen_at",
          "render",
          "filter",
          "prediction"
        ],
        "properties": {
          "position": {
            "type": "integer"
          },
          "item_id": {
            "type": "string"
          },
          "native_id": {
            "type": "string"
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "enum": [
              "photo",
              "carousel",
              "video",
              "reel",
              "article",
              null
            ]
          },
          "sponsored": {
            "type": "boolean"
          },
          "suggested": {
            "type": "boolean"
          },
          "author": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "handle": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "followed": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            }
          },
          "caption": {
            "type": [
              "string",
              "null"
            ]
          },
          "hashtags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mentions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "media": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string"
                },
                "url": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "width": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "height": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "alt_text": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "posted_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "posted_precision": {
            "enum": [
              "exact",
              "unknown"
            ]
          },
          "location": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "like_count": {
            "type": [
              "integer",
              "null"
            ]
          },
          "comment_count": {
            "type": [
              "integer",
              "null"
            ]
          },
          "seen_before": {
            "type": "boolean"
          },
          "first_seen_at": {
            "type": "string"
          },
          "render": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "screenshot",
                  "width",
                  "height",
                  "rendered_at"
                ],
                "properties": {
                  "screenshot": {
                    "type": "string",
                    "description": "Owner-authenticated URL path of the PNG"
                  },
                  "width": {
                    "type": "integer"
                  },
                  "height": {
                    "type": "integer"
                  },
                  "rendered_at": {
                    "type": "string"
                  }
                }
              }
            ]
          },
          "filter": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "passed",
                  "reason"
                ],
                "properties": {
                  "passed": {
                    "type": "boolean"
                  },
                  "reason": {
                    "enum": [
                      "above_threshold",
                      "exploration",
                      "no_text",
                      "jev_error",
                      "below_threshold",
                      "page_cap",
                      "budget",
                      null
                    ]
                  }
                }
              }
            ]
          },
          "prediction": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "p_match",
                  "p_engage",
                  "confidence",
                  "calibrated",
                  "model_version",
                  "scorer",
                  "preference_summary_version",
                  "cost_usd"
                ],
                "properties": {
                  "p_match": {
                    "type": "number",
                    "description": "P(match level >= medium), 0..1"
                  },
                  "p_engage": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "confidence": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "calibrated": {
                    "const": false
                  },
                  "model_version": {
                    "type": "string"
                  },
                  "scorer": {
                    "const": "jev"
                  },
                  "preference_summary_version": {
                    "type": "string"
                  },
                  "cost_usd": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    },
    "filtered_out": {
      "type": "integer",
      "description": "Posts held back by the filter (0 when no filter is used)"
    }
  }
}
