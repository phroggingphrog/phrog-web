    "function": {
      "name": "web_fetch",
      "description": "Extract clean Markdown content from a URL via Phrog Web (cascading through Plain HTTP, Crawl4AI headless, and TinyFish).",
      "parameters": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Target URL to fetch and convert to Markdown"
          },
          "mode": {
            "type": "string",
            "enum": [
              "plain",
              "browser",
              "auto"
            ],
            "default": "auto",
            "description": "Strategy: plain (fast), browser (Crawl4AI), or auto (smart fallback)"
          },
          "max_chars": {
            "type": "integer",
            "default": 50000,
            "description": "Maximum Markdown character length"
          }
        },
        "required": [
          "url"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "web_research",
      "description": "Synthesize research. Quick mode returns in ~4s (Vane). Deep workflows (lit, deepresearch, compare, audit, review, draft, recipe) dispatch autonomous Feynman agent in background.",
      "parameters": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string",
            "description": "Question or research topic"
          },
          "domain": {
            "type": "string",
            "enum": [
              "web",
              "academic",
              "discussions",
              "all"
            ],
            "default": "web",
            "description": "Domain target: web, academic (peer-reviewed papers), discussions"
          },
          "workflow": {
            "type": "string",
            "enum": [
              "quick",
              "deepresearch",
              "lit",
              "compare",
              "audit",
              "review",
              "draft",
              "recipe",
              "summarize"
            ],
            "default": "quick",
            "description": "quick (Vane 4s synthesis) or Feynman workflow (lit: literature review, compare: cross-paper matrix, audit: code vs paper)"
          },
          "callback_url": {
            "type": "string",
            "description": "Optional webhook URL to receive deep research results when complete"
          }
        },
        "required": [
          "question"
        ]
      }
    }
  },
