    "type": "function",
    "function": {
      "name": "feed",
      "description": "Read Instagram or RSS feeds in source order with optional screenshots.",
      "parameters": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "instagram",
              "rss"
            ],
            "default": "instagram"
          },
          "account": {
            "type": "string",
            "description": "Instagram account name, letters, digits, dot, underscore, max 30 (instagram only)"
          },
          "source": {
            "type": "string",
            "description": "instagram: \"home\" (default). rss: an RSSHub route like /youtube/channel/UC... or an http(s) feed URL (required for rss)"
          },
          "limit": {
            "type": "integer",
            "default": 20,
            "minimum": 1,
            "maximum": 50
          },
          "cursor": {
            "type": "string",
            "description": "next_cursor from the previous page"
          },
          "screenshots": {
            "type": "boolean",
            "default": true,
            "description": "Visual context without preference filtering."
          }
        },
        "required": []
      }
    }
  }
